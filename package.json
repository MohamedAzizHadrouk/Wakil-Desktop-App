{
  "name": "wakil-desktop",
  "productName": "Wakil Desktop",
  "version": "0.10.0",
  "description": "Visualiseur en lecture seule d'un écosystème Wakil (entités, projets, agents, skills, commandes).",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c magenta,cyan \"vite --port 5317 --strictPort\" \"wait-on tcp:5317 && cross-env WAKIL_DEV_URL=http://localhost:5317 electron .\"",
    "build": "tsc --noEmit && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build && electron-builder --win nsis",
    "sync-template": "node scripts/sync-template.cjs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  },
  "author": "Aziz Hadrouk",
  "build": {
    "appId": "com.wakil.desktop",
    "productName": "Wakil Desktop",
    "copyright": "Wakil",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wakil Desktop",
      "artifactName": "Wakil-Desktop-Setup-${version}.exe"
    },
    "extraResources": [
      {
        "from": "template",
        "to": "template",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
